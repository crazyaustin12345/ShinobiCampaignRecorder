  if(!okTot(duel.ot,no)||(dm&&!okTot(duel.dt,JT.Defense.dice)))return;
  var O=duel.ot,D=dm?duel.dt:0,costA=JT[mv.cat].cost,costD=dm?JT.Defense.cost:0,sc=JT.Supplementary.cost,dmg=Math.max(0,O-D),total=dmg+AUTO;
