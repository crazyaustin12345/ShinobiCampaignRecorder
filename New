    else logTo(m,c.name+": Chakra "+was+" to "+c.ck+" ("+sg+").","ck","",{who:c.name,ck:Math.max(0,-diff)});
  }
  cpersist();renderChars();if(k==="hp"&&was>0&&c.hp<=0)flash("emsg",c.name+" is in Death Saving Mode!");
}
$("chars").onclick=function(ev){cardAction(ev,false)};

/* ---- ninja map ---- */
var CELL=50,GW=40,GH=28;
var mapS={tokens:[],turn:1,dice:"1d12",zoom:.6,grid:true,enf:true};
var VPOS={v1:[30,19],v2:[33,13],v3:[26,12],v4:[31,4],v5:[7,19],v6:[8,6]};
var VCOL={v1:"#f26a0f",v2:"#1f6fd6",v3:"#2e9e5b",v4:"#8e44ad",v5:"#d4a017",v6:"#6b7280",v7:"#991b1b"};
function loadMap(){try{var r=localStorage.getItem(MAPK);if(r){var o=JSON.parse(r);if(o&&Array.isArray(o.tokens))mapS=Object.assign(mapS,o)}}catch(e){}}
function saveMap(){sv(MAPK,mapS)}
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function blob(cx,cy,rx,ry,R){
  var n=18,p=[],i,a,r,mid=function(u,w){return[(u[0]+w[0])/2,(u[1]+w[1])/2]};
  for(i=0;i<n;i++){a=i/n*6.2832;r=.84+.26*R();p.push([cx+Math.cos(a)*rx*r,cy+Math.sin(a)*ry*r])}
  var m0=mid(p[n-1],p[0]),d="M"+m0[0].toFixed(0)+" "+m0[1].toFixed(0);
  for(i=0;i<n;i++){var q=p[i],m=mid(q,p[(i+1)%n]);d+="Q"+q[0].toFixed(0)+" "+q[1].toFixed(0)+" "+m[0].toFixed(0)+" "+m[1].toFixed(0)}
  return d+"Z";
}
function buildMap(){
  var R=rng(11),W=GW*CELL,H=GH*CELL,s="",i,x,y,v;
  var vp=Object.keys(VPOS).map(function(k){return[VPOS[k][0]*CELL+25,VPOS[k][1]*CELL+25]});
  var clear=function(px,py){return !vp.some(function(q){return Math.hypot(q[0]-px,q[1]-py)<80})};
  var pick=function(cx,cy,rx,ry){var px,py,t=0;do{px=cx+(R()*2-1)*rx;py=cy+(R()*2-1)*ry;t++}while((Math.pow((px-cx)/rx,2)+Math.pow((py-cy)/ry,2)>1||!clear(px,py))&&t<30);return[px,py]};
  var regs=[[900,700,420,380,"#b5c27e"],[1350,820,470,400,"#5aa05c"],[330,980,340,330,"#e2c47f"],[430,330,390,290,"#a39a8f"],[1500,270,400,240,"#98a6c2"]].map(function(r){return{p:blob(r[0],r[1],r[2],r[3],R),f:r[4]}});
  s+='<rect width="'+W+'" height="'+H+'" fill="#2f78b7"/>';
  for(i=0;i<110;i++){x=R()*W;y=R()*H;s+='<path d="M'+x.toFixed(0)+" "+y.toFixed(0)+'q12 -8 24 0t24 0" stroke="#6aa8da" stroke-width="2" fill="none" opacity=".6"/>'}
  regs.forEach(function(r){s+='<path d="'+r.p+'" fill="#ebdfb2" stroke="#ebdfb2" stroke-width="26" stroke-linejoin="round"/>'});
  regs.forEach(function(r){s+='<path d="'+r.p+'" fill="'+r.f+'"/>'});
  s+='<path d="M1180 440C1150 560 1250 640 1180 760S1050 900 1120 1060S1250 1250 1180 1420" stroke="#4b9be0" stroke-width="9" fill="none" stroke-linecap="round"/>';
  s+='<path d="M560 420C640 520 700 560 720 700S820 860 760 1000S800 1300 840 1400" stroke="#4b9be0" stroke-width="9" fill="none" stroke-linecap="round"/>';
  s+='<ellipse cx="1000" cy="560" rx="90" ry="55" fill="#4b9be0" stroke="#3b82c4" stroke-width="4"/>';
  var greens=["#2f7a3d","#3b8f49","#2a6b36"];
  for(i=0;i<260;i++){v=pick(1350,820,400,330);s+='<circle cx="'+v[0].toFixed(0)+'" cy="'+v[1].toFixed(0)+'" r="'+(7+R()*5).toFixed(0)+'" fill="'+greens[i%3]+'"/>'}
  for(i=0;i<40;i++){v=pick(900,700,340,300);s+='<circle cx="'+v[0].toFixed(0)+'" cy="'+v[1].toFixed(0)+'" r="'+(5+R()*4).toFixed(0)+'" fill="#7f9a55"/>'}
  for(i=0;i<90;i++){v=pick(330,980,260,250);s+='<path d="M'+v[0].toFixed(0)+" "+v[1].toFixed(0)+'q18 -14 36 0" stroke="#c9a45a" stroke-width="4" fill="none" stroke-linecap="round"/>'}
  var peaks=function(cx,cy,rx,ry,n,body,snow){for(var j=0;j<n;j++){var q=pick(cx,cy,rx,ry),h=26+R()*16;s+='<polygon points="'+q[0].toFixed(0)+","+(q[1]-h).toFixed(0)+" "+(q[0]-h*.8).toFixed(0)+","+(q[1]+h*.4).toFixed(0)+" "+(q[0]+h*.8).toFixed(0)+","+(q[1]+h*.4).toFixed(0)+'" fill="'+body+'"/><polygon points="'+q[0].toFixed(0)+","+(q[1]-h).toFixed(0)+" "+(q[0]-h*.26).toFixed(0)+","+(q[1]-h*.5).toFixed(0)+" "+(q[0]+h*.26).toFixed(0)+","+(q[1]-h*.5).toFixed(0)+'" fill="'+snow+'"/>'}};
  peaks(430,330,300,210,60,"#7d746b","#e9edf2");peaks(1500,270,300,170,55,"#6e7d9c","#f4f7fc");
  var road=function(pts){s+='<path d="M'+pts.map(function(q){return q[0]+" "+q[1]}).join("L")+'" stroke="#7a5230" stroke-width="5" stroke-dasharray="12 9" fill="none" opacity=".85" stroke-linejoin="round"/>'};
  var c=function(k){return[VPOS[k][0]*CELL+25,VPOS[k][1]*CELL+25]};
  road([c("v3"),c("v2")]);road([c("v3"),c("v1")]);road([c("v1"),c("v2")]);road([c("v2"),[1625,450],c("v4")]);
  road([c("v3"),[1000,760],[700,900],c("v5")]);road([[1000,760],[800,560],c("v6")]);
  var lab=function(t,px,py){s+='<text x="'+px+'" y="'+py+'" text-anchor="middle" font-size="58" font-weight="700" letter-spacing="6" fill="#fff" opacity=".38" font-family="Dela Gothic One,Anton,Impact,sans-serif">'+t+"</text>"};
  lab("FIRE COUNTRY",1400,1180);lab("WIND COUNTRY",330,1250);lab("EARTH COUNTRY",430,150);lab("LIGHTNING COUNTRY",1500,90);lab("NEUTRAL PLAINS",900,820);
  $("mstatic").innerHTML=s;
  var g="";for(i=1;i<GW;i++)g+="M"+i*CELL+" 0V"+H;for(i=1;i<GH;i++)g+="M0 "+i*CELL+"H"+W;
  $("mgridl").setAttribute("d",g);
}
function drawVillages(){
  $("mvill").innerHTML=villages.filter(function(v){return VPOS[v.id]}).map(function(v){
    var p=VPOS[v.id],x=p[0]*CELL+25,y=p[1]*CELL+25,col=VCOL[v.id]||"#555";
    return'<g transform="translate('+x+" "+y+')" style="pointer-events:none"><circle r="30" fill="#fff" stroke="'+col+'" stroke-width="6"/>'
    +'<polygon points="-14,2 0,-14 14,2" fill="'+col+'"/><rect x="-10" y="2" width="20" height="13" fill="'+col+'"/><rect x="-3" y="7" width="6" height="8" fill="#fff"/>'
    +'<text y="56" text-anchor="middle" font-size="22" font-weight="700" fill="#fff" stroke="#10213a" stroke-width="5" paint-order="stroke" font-family="Source Sans 3,sans-serif">'+esc(v.name)+"</text></g>";
  }).join("");
}
function tinfo(t){var s=(t.src==="c"?chars:roster).filter(function(x){return x.id===t.ref})[0];return s?{name:s.name,img:s.img,vid:s.vid,down:t.src==="c"&&s.hp<=0}:{name:t.name,img:"",vid:t.vid,down:false}}
function drawTokens(){
  $("mtok").innerHTML=mapS.tokens.map(function(t){
    var i=tinfo(t),col=VCOL[i.vid]||"#444",ok=i.img&&/^data:image\//.test(i.img);
    var face=ok?'<image href="'+esc(i.img)+'" x="-23" y="-23" width="46" height="46" clip-path="url(#tc)" preserveAspectRatio="xMidYMid slice"/>':'<circle r="23" fill="#fff"/><text y="9" text-anchor="middle" font-size="26" font-weight="700" fill="'+col+'" font-family="Dela Gothic One,Anton,Impact,sans-serif">'+esc((i.name||"?").charAt(0).toUpperCase())+"</text>";
    var badge=t.moveLeft!=null?'<circle cx="20" cy="-20" r="13" fill="#f26a0f" stroke="#fff" stroke-width="2"/><text x="20" y="-14" text-anchor="middle" font-size="16" font-weight="700" fill="#fff">'+t.moveLeft+"</text>":"";
    return'<g class="tok" data-id="'+t.id+'" transform="translate('+(t.x*CELL+25)+" "+(t.y*CELL+25)+')"><circle r="27" fill="'+col+'"/>'+face+'<circle r="23" fill="none" stroke="'+(i.down?"#ff2d2d":"#fff")+'" stroke-width="'+(i.down?4:2)+'"/>'+badge
    +'<text y="46" text-anchor="middle" font-size="16" font-weight="700" fill="#fff" stroke="#10213a" stroke-width="4" paint-order="stroke" font-family="Source Sans 3,sans-serif">'+esc(i.name)+"</text></g>";
  }).join("");
}
function renderTokList(){
  $("turnlbl").textContent="Turn "+mapS.turn;
  $("toklist").innerHTML=mapS.tokens.length?mapS.tokens.map(function(t){
    var i=tinfo(t);
    return'<div class="trow">'+avatar({img:i.img,name:i.name},"sm")+'<div class="tin"><b>'+esc(i.name)+'</b><div class="jm">'+esc(vname(i.vid)||"No village")+tmn(t)+" | "+(t.moveLeft==null?"Not rolled this turn":"Rolled "+t.rolled+", "+t.moveLeft+" squares left")+"</div></div>"
    +'<div class="jbtn"><button class="small" data-t="roll" data-id="'+t.id+'">Roll movement</button><button class="small danger" data-t="rm" data-id="'+t.id+'">Remove</button></div></div>';
  }).join(""):'<p class="note">No tokens yet. Choose a character above and select Place token.</p>';
}
function fillTpick(){
  var cur=$("tpick").value;
  $("tpick").innerHTML='<option value="">Choose a character...</option>'+missionOpts()+charOptions(roster,null,"r:");
  $("tpick").value=cur;
}
function applyZoom(){var z=mapS.zoom;$("map").setAttribute("width",GW*CELL*z);$("map").setAttribute("height",GH*CELL*z)}
function renderMap(){
  fillTpick();drawVillages();drawTokens();renderTokList();applyZoom();
  $("mgridl").style.display=mapS.grid?"":"none";$("mgrid").checked=!!mapS.grid;$("menf").checked=!!mapS.enf;$("mdice").value=mapS.dice;
}
function rollDice(expr){
  var m=/^\s*(\d+)\s*d\s*(\d+)\s*([+-]\s*\d+)?\s*$/i.exec(expr||"");if(!m)return null;
  var n=Math.min(50,+m[1]),d=Math.max(2,+m[2]),tot=m[3]?parseInt(m[3].replace(/\s/g,""),10):0,i;
  for(i=0;i<n;i++)tot+=1+Math.floor(Math.random()*d);return Math.max(0,tot);
}
function rollMove(t){
  var i=tinfo(t);
  if(t.moveLeft!=null){flash("mmsg",i.name+" already rolled this turn.");return}
  var v=rollDice(mapS.dice);if(v==null){flash("mmsg","Movement dice must look like 1d12 or 2d6+1.");return}
  t.rolled=v;t.moveLeft=v;saveMap();flash("mmsg",i.name+" rolled "+mapS.dice+" and can move "+v+" squares.");
}
function tok(id){return mapS.tokens.filter(function(t){return t.id===id})[0]}
function placeToken(src,id){
  var s=(src==="c"?chars:roster).filter(function(x){return x.id===id})[0];if(!s)return"";
  if(mapS.tokens.some(function(t){return t.src===src&&t.ref===id}))return s.name+" already has a token.";
  var p=VPOS[s.vid]||[20,14],n=mapS.tokens.filter(function(t){return Math.abs(t.x-p[0])<=3&&Math.abs(t.y-p[1])<=3}).length;
  mapS.tokens.push({id:uid("t"),src:src,ref:id,name:s.name,vid:s.vid||"",x:Math.min(GW-1,p[0]+1+n%3),y:Math.min(GH-1,p[1]+1+Math.floor(n/3)%3),moveLeft:null,rolled:null});
  saveMap();drawTokens();renderTokList();return"ok";
}
$("tadd").onclick=function(){
  var v=$("tpick").value;if(!v){flash("mmsg","Choose a character first.");return}
  var r=placeToken(v.charAt(0),v.slice(2));if(r&&r!=="ok")flash("mmsg",r);
};
$("toklist").onclick=function(ev){
  var b=ev.target.closest("button");if(!b)return;var t=tok(b.dataset.id);if(!t)return;
  if(b.dataset.t==="roll"){rollMove(t)}
  else if(b.dataset.t==="rm"){mapS.tokens=mapS.tokens.filter(function(x){return x.id!==t.id});saveMap()}
  drawTokens();renderTokList();
};
$("rollall").onclick=function(){mapS.tokens.forEach(function(t){if(t.moveLeft==null)rollMove(t)});drawTokens();renderTokList()};
$("nextturn").onclick=function(){mapS.turn++;mapS.tokens.forEach(function(t){t.moveLeft=null;t.rolled=null});saveMap();flash("mmsg","Turn "+mapS.turn+" begins. Everyone can roll movement again.");drawTokens();renderTokList()};
$("mdice").onchange=function(){mapS.dice=this.value.trim()||"1d12";saveMap()};
$("menf").onchange=function(){mapS.enf=this.checked;saveMap()};
$("mgrid").onchange=function(){mapS.grid=this.checked;$("mgridl").style.display=mapS.grid?"":"none";saveMap()};
$("zin").onclick=function(){mapS.zoom=Math.min(1.5,+(mapS.zoom+.15).toFixed(2));applyZoom();saveMap()};
$("zout").onclick=function(){mapS.zoom=Math.max(.3,+(mapS.zoom-.15).toFixed(2));applyZoom();saveMap()};
var drag=null;
function svgPt(ev){var s=$("map"),p=s.createSVGPoint();p.x=ev.clientX;p.y=ev.clientY;return p.matrixTransform(s.getScreenCTM().inverse())}
$("map").addEventListener("pointerdown",function(ev){
  var g=ev.target.closest(".tok");if(!g)return;var t=tok(g.dataset.id);if(!t)return;
  ev.preventDefault();try{g.setPointerCapture(ev.pointerId)}catch(e){}
  drag={g:g,t:t,sx:t.x,sy:t.y};g.parentNode.appendChild(g);
});
$("map").addEventListener("pointermove",function(ev){
  if(!drag)return;var p=svgPt(ev);
  drag.g.setAttribute("transform","translate("+Math.max(0,Math.min(GW*CELL,p.x))+" "+Math.max(0,Math.min(GH*CELL,p.y))+")");
});
function endDrag(ev){
  if(!drag)return;var d=drag;drag=null;var p=svgPt(ev);
  var cx=Math.max(0,Math.min(GW-1,Math.floor(p.x/CELL))),cy=Math.max(0,Math.min(GH-1,Math.floor(p.y/CELL))),cost=Math.max(Math.abs(cx-d.sx),Math.abs(cy-d.sy)),t=d.t;
  if(cost>0){
    if(mapS.enf&&t.moveLeft!=null&&cost>t.moveLeft)flash("mmsg","Not enough movement: that move costs "+cost+" and "+tinfo(t).name+" has "+t.moveLeft+" left.");
    else{t.x=cx;t.y=cy;if(t.moveLeft!=null)t.moveLeft-=cost;saveMap()}
  }
  drawTokens();renderTokList();
}
$("map").addEventListener("pointerup",endDrag);
$("map").addEventListener("pointercancel",function(){drag=null;drawTokens()});

/* ---- views ---- */
