<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Shinobi Campaign Episode Recorder</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Dela+Gothic+One&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f5fa;--surface:#fff;--ink:#141a2b;--muted:#5a6580;--line:#d5dbe8;--orange:#f26a0f;--blue:#1f6fd6;--chip:#e8eefb;--on-accent:#fff;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10141f;--surface:#1a2133;--ink:#eef1f8;--muted:#9aa5c0;--line:#2c3550;--orange:#ff8a3d;--blue:#5aa2ff;--chip:#24304d;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#10141f;--surface:#1a2133;--ink:#eef1f8;--muted:#9aa5c0;--line:#2c3550;--orange:#ff8a3d;--blue:#5aa2ff;--chip:#24304d;color-scheme:dark}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 "Source Sans 3",system-ui,sans-serif}
.wrap{max-width:900px;margin:0 auto;padding:20px 16px 60px}
header{border-bottom:6px solid var(--orange);padding-bottom:14px;margin-bottom:18px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;justify-content:space-between}
h1{font:400 clamp(32px,7vw,56px)/1 Dela Gothic One,Anton,Impact,sans-serif;margin:0;letter-spacing:.01em;text-transform:uppercase}
h1 span{color:var(--orange)}
.sub{color:var(--muted);margin:6px 0 0}
button{font:600 15px "Source Sans 3",sans-serif;border:2px solid var(--ink);background:var(--surface);color:var(--ink);padding:8px 14px;border-radius:6px;cursor:pointer}
button:hover{background:var(--chip)}
button.primary{background:var(--orange);border-color:var(--orange);color:var(--on-accent)}
button.primary:hover{filter:brightness(1.08)}
button.danger{border-color:#c63a3a;color:#c63a3a}
button.small{padding:4px 10px;font-size:14px}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.tools{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}
.tools input[type=search]{flex:1 1 220px}
input,textarea,select{width:100%;font:inherit;color:var(--ink);background:var(--surface);border:2px solid var(--line);border-radius:6px;padding:8px 10px}
textarea{resize:vertical;min-height:70px}
.stats{display:flex;gap:18px;flex-wrap:wrap;color:var(--muted);margin:0 0 18px;font-weight:600}
.stats b{color:var(--ink);font:400 24px Dela Gothic One,Anton,sans-serif;margin-right:4px}
.ep{display:grid;grid-template-columns:84px 1fr;background:var(--surface);border:2px solid var(--ink);border-radius:8px;margin-bottom:16px;overflow:hidden}
.num{background:var(--blue);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font:400 44px/1 Dela Gothic One,Anton,sans-serif;padding:10px 0}
.num small{font:600 12px "Source Sans 3",sans-serif;opacity:.85;margin-bottom:4px}
.body{padding:14px 16px}
.body h2{margin:0;font:400 26px/1.15 Dela Gothic One,Anton,sans-serif;letter-spacing:.01em}
.meta{color:var(--muted);font-size:14px;margin:4px 0 8px}
.meta .arc{color:var(--orange);font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.chip{background:var(--chip);border-radius:99px;padding:2px 10px;font-size:14px}
.chip.j{border:1px solid var(--blue)}
.field{margin:10px 0 0}
.field h3{margin:0;font-size:14px;color:var(--blue);font-weight:700}
.field p{margin:2px 0 0;white-space:pre-wrap}
.hook{border-left:5px solid var(--orange);padding-left:10px}
.acts{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.empty{border:2px dashed var(--line);border-radius:8px;padding:34px 20px;text-align:center;color:var(--muted)}
dialog{width:min(640px,94vw);border:3px solid var(--ink);border-radius:10px;background:var(--bg);color:var(--ink);padding:0}
dialog::backdrop{background:rgba(8,12,24,.6)}
form,.dlg{padding:18px}
dialog h2{font:400 28px Dela Gothic One,Anton,sans-serif;margin:0 0 12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;font-weight:600;font-size:14px;margin-top:12px}
.grid label{margin-top:0}
label small{font-weight:400;color:var(--muted)}
.full{grid-column:1/-1}
.dacts{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}
.panel{margin-bottom:22px}.phead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.phead h2{font:400 28px Dela Gothic One,Anton,sans-serif;margin:0;text-transform:uppercase}
.pcs{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px}
.pc{background:var(--surface);border:2px solid var(--ink);border-radius:8px;padding:12px 14px}
.pc.down{border-color:#c63a3a}
.pch{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:6px}.pch strong{font:400 22px Dela Gothic One,Anton,sans-serif}
.rk{background:var(--orange);color:#fff;border-radius:4px;padding:1px 8px;font-size:13px;font-weight:700}
.mt{margin:8px 0}.mtl{display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:14px}
.mtl input{width:64px;padding:2px 6px;text-align:center;display:inline-block}
.track{height:14px;background:var(--chip);border-radius:99px;overflow:hidden;margin:4px 0 6px}
.fill{height:100%;border-radius:99px;transition:width .2s}
.fill.hp{background:#2e9e5b}.fill.ck{background:var(--blue)}
.adj{display:flex;gap:4px}.adj button{flex:1;padding:3px 0;font-size:14px}
.jb{border-top:2px solid var(--line);margin-top:10px;padding-top:8px}.jh{font-weight:700;font-size:14px;color:var(--blue)}
.jr{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:4px 0}.jm{color:var(--muted);font-size:13px}.jbtn{display:flex;gap:4px}
.roll{background:var(--chip);border-left:5px solid var(--orange);padding:6px 10px;margin:6px 0;font-weight:600;font-size:14px}
button:disabled{opacity:.45;cursor:not-allowed}.dlg form{padding:0}
.jlrow{display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:1px solid var(--line);padding:6px 0}.jlist{max-height:240px;overflow:auto;margin-top:8px}
.fx{font-size:14px;margin:0 0 6px}.fx summary{cursor:pointer;color:var(--blue);font-weight:600}.fx div{margin-left:12px}
.mv{border:2px solid var(--line);border-radius:8px;padding:10px;margin-bottom:10px;background:var(--surface)}.mcost{display:block;padding:8px 0;color:var(--muted)}
details.imp{margin-top:8px}details.imp summary{cursor:pointer;font-weight:600;color:var(--blue)}
.pc .acts{margin-top:10px}.note{color:var(--muted);font-size:14px;margin:0}.downtag{color:#c63a3a;font-weight:700;font-size:14px}
@media(max-width:560px){.ep{grid-template-columns:56px 1fr}.num{font-size:30px}.grid{grid-template-columns:1fr}}
.hidden{display:none!important}.phead{flex-wrap:wrap}
.tabs{display:flex;gap:6px}.tabs button[aria-selected=true]{background:var(--ink);color:var(--bg)}
.pbtns{display:flex;gap:8px;flex-wrap:wrap}
.av{width:56px;height:56px;border-radius:8px;object-fit:cover;border:2px solid var(--ink);flex:none;background:var(--chip);display:block}
.av.ini{display:flex;align-items:center;justify-content:center;font:400 28px Dela Gothic One,Anton,sans-serif;color:var(--blue)}
.av.big{width:96px;height:96px}.who{display:flex;gap:10px;align-items:center;min-width:0}
.pic{display:flex;gap:14px;align-items:center;margin-bottom:12px}
.kwrow{display:flex;flex-wrap:wrap;gap:6px}.kw{border-radius:99px;padding:2px 10px;font-size:14px;border:2px solid var(--line)}
.kw.on{background:var(--orange);border-color:var(--orange);color:#fff}
.sr{display:flex;gap:6px}.sr select{flex:1}.lbl{font-weight:600;font-size:14px;margin-bottom:4px}
#cmsg{min-height:22px;margin:0 0 8px;color:var(--blue);font-weight:600}
.av{width:104px;height:104px}.av.ini{font-size:52px}.av.big{width:160px;height:160px}.av.big.ini{font-size:80px}
.pch strong{font:400 17px/1.15 Dela Gothic One,Anton,sans-serif;letter-spacing:.01em}
.who{align-items:flex-start;gap:12px}.wi{display:flex;flex-direction:column;gap:4px;align-items:flex-start;min-width:0;padding-top:2px}
.vn{color:var(--muted);font-size:14px;font-weight:600;line-height:1.25}
.rk.npc{background:var(--blue)}
.vgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;margin-bottom:26px}
.vc{background:var(--surface);border:2px solid var(--ink);border-top:6px solid var(--orange);border-radius:8px;padding:12px 14px}
.vh{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.vh strong{font:400 18px/1.15 Dela Gothic One,Anton,sans-serif}
.ryo{font:400 40px/1.1 Dela Gothic One,Anton,sans-serif;margin:8px 0}.ryo small{font:600 14px "Source Sans 3",sans-serif;color:var(--muted)}
.vin{display:grid;grid-template-columns:1fr 1.4fr;gap:8px}.vin label{margin-top:0}
.vc .acts{margin-top:10px}#vmsg{min-height:22px;margin:0 0 8px;color:var(--blue);font-weight:600}
#vfil{width:auto}
.nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.nav button[aria-selected=true]{background:var(--orange);border-color:var(--orange);color:#fff}
.ctl{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;align-items:center}.ctl select{width:auto;max-width:100%;flex:1 1 200px}
label.inl{display:inline-flex;align-items:center;gap:6px;margin:0;font-weight:600}label.inl input[type=text]{width:90px}
.av.sm{width:40px;height:40px;border-radius:50%}.av.sm.ini{font-size:20px}
.mapwrap{height:72vh;min-height:360px;overflow:auto;border:2px solid var(--ink);border-radius:8px;background:#2f78b7}.mapwrap svg{display:block}
.tok{cursor:grab;touch-action:none}.tok:active{cursor:grabbing}
.trow{display:flex;align-items:center;gap:10px;background:var(--surface);border:2px solid var(--line);border-radius:8px;padding:8px 10px;margin-top:8px}.tin{flex:1;min-width:0}
#mmsg{min-height:22px;margin:0 0 8px;color:var(--blue);font-weight:600}
.kwr{display:grid;grid-template-columns:1.2fr 1fr 1.6fr auto;gap:6px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}
.kwr input,.kwr select{margin:0}
@media(max-width:560px){.kwr{grid-template-columns:1fr 1fr}}
.pc.dying{border-color:#e11d1d;background:linear-gradient(180deg,rgba(225,29,29,.16),transparent 45%),var(--surface);animation:dsspulse 1.2s ease-in-out infinite}
@keyframes dsspulse{0%,100%{box-shadow:0 0 0 0 rgba(225,29,29,.55),0 0 16px rgba(225,29,29,.35)}50%{box-shadow:0 0 0 6px rgba(225,29,29,0),0 0 34px rgba(225,29,29,.75)}}
.pc.stable{border-color:#2e9e5b}.pc.dead{border-color:#777;filter:grayscale(.85)}
.dss{margin:10px 0;border-radius:6px;padding:10px;background:#3a0b0b;color:#ffecec;border:2px solid #e11d1d;text-align:center}
.dss h4{margin:0;font:400 24px Dela Gothic One,Anton,sans-serif;letter-spacing:.1em;animation:dssblink 1s steps(2,jump-none) infinite}
@keyframes dssblink{50%{opacity:.4}}
.dss p{margin:6px 0;font-size:14px}.dss.stable{background:#0e2e1b;border-color:#3ecf6e;color:#e6ffee}.dss.stable h4,.dss.dead h4{animation:none}.dss.dead{background:#151515;border-color:#777;color:#ccc}
.pips{display:flex;gap:8px;justify-content:center;align-items:center;margin:6px 0}.pips small{width:70px;text-align:right}
.pip{width:22px;height:22px;border-radius:50%;border:2px solid #ffb3b3;display:inline-block}.pip.ok{background:#3ecf6e;border-color:#3ecf6e}.pip.bad{background:#e11d1d;border-color:#ff8a8a}
.pc.act{box-shadow:0 0 0 4px var(--orange)}.pc.idle{opacity:.72}
.phtag{background:var(--orange);color:#fff;font-weight:700;font-size:13px;padding:2px 8px;border-radius:4px;display:inline-block;margin-top:8px}
.phasebar{background:var(--surface);border:2px solid var(--ink);border-radius:8px;padding:10px 12px;margin-bottom:12px;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.phr{font:400 26px Dela Gothic One,Anton,sans-serif}.phcur{flex:1 1 240px}.phrow{display:flex;gap:6px;flex-wrap:wrap}
.php{border:2px solid var(--line);border-radius:99px;padding:2px 12px;font-weight:700;font-size:14px;color:var(--muted)}.php.on{background:var(--orange);border-color:var(--orange);color:#fff}.php.done{text-decoration:line-through;opacity:.6}
@media (prefers-reduced-motion:reduce){.pc.dying,.dss h4{animation:none}}
body{font-size:17px}
.vwrap.max{position:fixed;inset:0;z-index:50;background:var(--bg);overflow:auto;padding:24px}
.vwrap.max .vc{max-width:780px;margin:0 auto}.vwrap.max .ryo{font-size:96px}.vwrap.max .vh strong{font-size:36px}.vwrap.max .vclose{display:block;margin:0 auto 14px}
#villages .vc{max-width:600px}.vclose{display:none}
.mpill{display:inline-flex;flex-direction:column;align-items:flex-start;gap:2px;margin:0 8px 8px 0;text-align:left}
.mpill.on{background:var(--ink);color:var(--bg)}.mpill.on .jm{color:var(--bg)}
.mhead h3{margin:0;font:400 30px Dela Gothic One,Anton,sans-serif}.mrank{font-weight:700;color:var(--orange)}
.mfacts{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
.tm{font-weight:700}.tm.ok{color:#2e9e5b}.tm.bad{color:#c63a3a}
#epws .panel{background:var(--surface);border:2px solid var(--line);border-radius:8px;padding:14px;margin-bottom:16px}
.hist h4{margin:14px 0 4px;font:400 20px Dela Gothic One,Anton,sans-serif;letter-spacing:.02em}
.he{border-left:4px solid var(--line);padding:3px 0 3px 10px;margin:5px 0}.he.jutsu{border-color:var(--orange)}.he.hp{border-color:#e11d1d}.he.sys{border-color:var(--blue);color:var(--muted)}
#wrapup{border-color:var(--orange)!important}#wrapup textarea{min-height:90px}
.phcur .jm b{color:var(--ink)}
.strow{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.st{border-radius:99px;padding:1px 12px;font-size:14px;font-weight:600;border:2px solid var(--line);background:transparent;color:var(--muted)}
.st.on{color:#fff;border-color:transparent}
summary.jh{cursor:pointer;font-size:16px;padding:4px 0}
.hsum{width:100%;border-collapse:collapse;margin:6px 0 10px;font-size:15px}.hsum th,.hsum td{border-bottom:1px solid var(--line);padding:4px 8px;text-align:left}.hsum th{color:var(--muted);font-size:13px}
.ult{background:#3a0b0b;color:#ffecec;border:2px solid #e11d1d;border-radius:8px;padding:10px 12px;margin:10px 0}.ult .inl{color:#ffecec}
.adj{flex-wrap:wrap}.adj button{flex:1 1 auto}#duel{width:min(1000px,97vw)}
.duelrow{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:center;margin:12px 0}
