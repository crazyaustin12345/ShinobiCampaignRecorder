.ep{grid-template-columns:180px 1fr}
.epimg{position:relative;min-height:230px;background:var(--ink)}
.epimg img,.epimg svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.epbadge{position:absolute;left:8px;top:8px;background:var(--orange);color:#fff;font:400 18px Dela Gothic One,Anton,sans-serif;padding:3px 12px;border-radius:4px;box-shadow:0 2px 6px #0007}
.epwart{position:relative;width:92px;height:116px;border:2px solid var(--ink);border-radius:8px;overflow:hidden;flex:none;background:var(--ink)}
.epwart img,.epwart svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.epwart .epbadge{font-size:13px;padding:1px 8px;left:5px;top:5px}
@media(max-width:560px){.ep{grid-template-columns:104px 1fr}.epimg{min-height:170px}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div><h1>Shinobi <span>Chronicle</span></h1><p class="sub">Scrolls of every mission, battle and legend in your Ultimate Ninja Storm campaign.</p></div>
  <button class="primary" id="new">Inscribe new episode</button>
</header>
<nav class="nav" aria-label="Sections"><button data-view="camp" aria-selected="true">Villages &amp; Shinobi</button><button data-view="map" aria-selected="false">World Map</button><button data-view="eps" aria-selected="false">Episode Scrolls</button></nav>
<div id="v-camp">
<section class="panel" aria-label="Villages">
  <div class="phead"><h2>Hidden Villages</h2><div class="pbtns"><select id="vsel" aria-label="Choose a village" style="width:auto"></select><button id="vmax">Maximize</button><button id="newv">Add village</button></div></div>
  <p id="vmsg" role="status"></p>
  <div class="vwrap" id="vwrap"><button class="small vclose" id="vclose">Close full screen</button><div id="villages"></div></div>
</section>
<section class="panel" aria-label="Characters">
  <div class="phead"><h2>Shinobi Roster (<span id="cros">0</span>)</h2></div>
  <div class="ctl" id="ctl-r"><select id="vfil" aria-label="Filter characters by village"></select><select id="rpick" aria-label="Jump to a character"></select><button class="primary" id="newc">Add shinobi</button></div>
  <p id="cmsg" role="status"></p>
  <div class="pcs" id="chars"></div>
</section>
</div>
<div id="v-eps" class="hidden">
<div id="epws" class="hidden">
  <div class="phead"><button class="small" id="epback">&larr; Episode scrolls</button><div class="epwart" id="epwart"></div><h2 id="epwt">Episode</h2><button class="small" id="epwpick">Change image</button><input type="file" id="epwimg" accept="image/*" hidden><label class="inl">Death save succeeds on a D10 roll of <input id="dsst" type="number" min="1" max="10" style="width:64px">+</label></div>
  <div id="phasebar" class="phasebar hidden"></div>
  <p id="emsg" role="status" style="min-height:22px;margin:0 0 8px;color:var(--blue);font-weight:600"></p>
  <section class="panel hidden" id="wrapup" aria-label="Episode wrap-up"></section>
<section class="panel hidden" id="encpanel" aria-label="Encounter">
    <h3 style="margin:0 0 6px">Encounter</h3>
    <p class="note">The villain does not craft a mission. Instead the Akatsuki move around the map at random. Any Akatsuki member who ends up near deployed shinobi starts a fight with them, and that fight appears below as an encounter you can play out.</p>
    <div class="ctl"><button class="primary" id="enc">Trigger encounter</button><label class="inl">Encounter range <input id="erange" type="number" min="1" max="10" style="width:64px"> squares</label></div>
  </section>
  <section class="panel" id="mpanel" aria-label="Missions in this episode">
    <h3 style="margin:0 0 8px">Mission scrolls</h3>
    <div id="mlist"></div>
    <details class="imp" id="mcreate" open><summary>Draft a mission scroll</summary>
      <div class="grid" style="margin-top:8px">
        <label class="full">Mission rank<select id="mrank"><option value="C">C-Rank: Routine Assignment (Threat level 4, 200 Ryo)</option><option value="B">B-Rank: Dangerous Assignment (Threat level 5, 300 Ryo)</option><option value="A">A-Rank: High Priority (Threat level 7, 400 Ryo)</option><option value="S">S-Rank: Critical Assignment (Threat level 11, 500 Ryo)</option></select></label>
        <label class="full">Mission title <small>(optional)</small><input id="mname" type="text"></label><label class="full">Arc name <small>(so you know which arc to resume on your next episode)</small><input id="marc" type="text"></label>
      </div>
      <p class="note" id="mrinfo"></p>
      <p class="note">Villain shinobi are worth Genin 1, Chunin 2, Jonin 3, Kage 4. The villains you deploy must add up to the mission&rsquo;s threat level.</p>
      <button class="primary" id="mmake">Create mission</button>
    </details>
  </section>
  <section class="panel" id="mdetail" aria-label="Selected mission"></section>
</div>
<div id="eplist">
<div class="stats" id="stats"></div>
<div class="tools">
  <input type="search" id="q" placeholder="Search episodes, characters, jutsu, arcs" aria-label="Search episodes">
  <button id="order">Newest first</button>
  <button id="backup">Backup / restore</button>
</div>
<div id="list"></div>
</div></div>
<div id="v-map" class="hidden">
<section class="panel" aria-label="Map">
  <div class="phead"><h2>Ninja map</h2><div class="pbtns"><span class="rk" id="turnlbl">Turn 1</span><button class="primary" id="nextturn">Next turn</button><button id="rollall">Roll movement for all</button></div></div>
  <div class="ctl"><select id="tpick" aria-label="Choose a character to place on the map"></select><button id="tadd">Place token</button></div>
  <div class="ctl">
    <label class="inl">Movement dice <input id="mdice" type="text"></label>
    <label class="inl"><input type="checkbox" id="menf" style="width:auto"> Limit moves to the rolled distance</label>
    <label class="inl"><input type="checkbox" id="mgrid" style="width:auto"> Grid</label>
    <span class="pbtns"><button id="zout" aria-label="Zoom out">&minus;</button><button id="zin" aria-label="Zoom in">+</button></span>
  </div>
  <p id="mmsg" role="status"></p>
  <div class="mapwrap" id="mapwrap">
    <svg id="map" viewBox="0 0 2000 1400" role="img" aria-label="Ninja world map with character tokens">
      <defs><clipPath id="tc"><circle r="23"/></clipPath></defs>
      <g id="mstatic"></g><path id="mgridl" fill="none" stroke="#fff" stroke-opacity=".22" stroke-width="1"/><g id="mvill"></g><g id="mtok"></g>
    </svg>
  </div>
  <div id="toklist"></div>
</section>
</div>
</div>

<dialog id="dlg"><form id="f" method="dialog">
  <h2 id="dt">Record episode</h2>
  <div class="pic"><div id="epprev"></div><div>
    <button type="button" class="small" id="epickbtn">Choose image</button> <button type="button" class="small" id="epunpick">Remove image</button>
    <input type="file" id="epimg" accept="image/*" hidden>
    <p class="note" id="epimsg" role="status">Choose an image, drag one onto this window, or copy an image and paste it here with Ctrl+V.</p></div></div>
  <div class="grid">
    <label>Episode number<input type="number" id="num" min="1" required></label>
    <label>Session date<input type="date" id="date"></label>
    <label class="full">Episode title<input id="title" required></label>
    <label>Story arc<input id="arc"></label>
    <label>Mission rank
      <select id="rank"><option value="">None</option><option>D-Rank</option><option>C-Rank</option><option>B-Rank</option><option>A-Rank</option><option>S-Rank</option><option>Exam / Tournament</option><option>Story event</option></select></label>
  </div>
  <label>What happened<textarea id="summary" rows="4"></textarea></label>
  <label>Characters present <small>(comma separated)</small><input id="cast"></label>
  <label>Jutsu and techniques used <small>(comma separated)</small><input id="jutsu"></label>
  <label>Battles and outcomes<textarea id="battles" rows="3"></textarea></label>
  <label>Rewards, ryo, XP, items<textarea id="rewards" rows="2"></textarea></label>
  <label>Cliffhanger or next-session hook<textarea id="hook" rows="2"></textarea></label>
  <div class="dacts"><button type="button" id="cancel">Cancel</button><button class="primary" id="save" type="submit">Save episode</button></div>
</form></dialog>

<dialog id="cd"><form id="cf" method="dialog">
  <h2 id="cdt">Add character</h2>
  <p class="note hidden" id="cmnote">This is a mission copy. Changes here only affect this mission, not the character in All characters.</p>
  <div class="pic"><div id="cprev"></div><div>
    <button type="button" class="small" id="cpick">Choose image</button> <button type="button" class="small" id="cunpick">Remove image</button>
    <input type="file" id="cimg" accept="image/*" hidden>
    <p class="note" id="cimsg" role="status">Choose an image, drag one onto this window, or copy an image and paste it here with Ctrl+V. It is resized and saved in this browser.</p></div></div>
  <div class="grid">
    <label class="full">Name<input id="cname" required></label>
    <label class="full">Village<select id="cvil"></select></label>
    <label class="full">Rank
      <select id="crank"><option value="Genin">Genin (50 HP, 100 Chakra)</option><option value="Chunin">Chunin (60 HP, 120 Chakra)</option><option value="Jonin">Jonin (70 HP, 140 Chakra)</option><option value="Kage">Kage (80 HP, 160 Chakra)</option></select></label>
    <label>Max HP<input type="number" id="cmaxhp" min="1" required></label>
    <label>Max Chakra<input type="number" id="cmaxck" min="1" required></label>
  </div>
  <p class="note" style="margin-top:10px">Max values fill in from the rank. Change them for bonuses or penalties.</p>
  <div class="phead" style="margin:16px 0 6px"><h3 style="margin:0;font-size:18px">Moveset</h3><button type="button" class="small" id="addmv">Add jutsu</button></div>
  <p class="note">Offense: 50 Chakra and 5d12. Defense: 50 Chakra and 4d12. Supplementary and Awakening: 30 Chakra. Start an effect line with a number and a plus, like 35+, and it only triggers when the damage roll reaches that total. Offense and Defense jutsu have a base keyword plus a second keyword that unlocks at 35+ (Offense) or 30+ (Defense). Supplementary jutsu have two keywords that both apply. Awakening jutsu have a single keyword.</p>
  <details class="imp"><summary>Saved keywords</summary>
    <div class="grid" style="margin-top:8px"><label>Keyword<input id="kwname"></label><label>Category<select id="kwcat"><option>Offense</option><option>Defense</option><option>Supplementary</option><option>Awakening</option></select></label><label class="full">What it does <small>(optional)</small><input id="kwdesc"></label></div>
    <div style="margin:8px 0"><button type="button" class="small" id="kwadd">Save keyword</button></div>
    <p class="note" id="kwmsg" role="status"></p><div id="kwl"></div></details>
  <div id="mvrows" style="margin-top:10px"></div>
  <details class="imp"><summary>Paste jutsu from your list</summary>
    <textarea id="mvbulk" rows="7"></textarea>
    <p class="note">First line: name | category | keywords (category and keywords are optional). List the base keyword first, then the second keyword, separated by a comma. The next lines are the effects. Leave a blank line between jutsu. New keywords are saved under that jutsu&rsquo;s category.</p>
    <button type="button" class="small" id="mvimp">Add pasted jutsu</button> <span id="mvmsg" class="note" role="status"></span></details>
  <div class="dacts"><button type="button" id="ccancel">Cancel</button><button class="primary" type="submit">Save character</button></div>
</form></dialog>

<dialog id="duel"><div class="dlg" id="duelbody"></div></dialog>

<dialog id="vd"><form id="vf" method="dialog">
  <h2 id="vdt">Add village</h2>
  <div class="grid">
    <label class="full">Village name<input id="vname" required></label>
    <label>Controlled by<input id="vown"></label>
    <label>Ryo balance<input type="number" id="vryo" min="0"></label>
  </div>
  <p class="note" style="margin-top:10px">Use NPC as the controller for villages you run yourself.</p>
  <div class="dacts"><button type="button" id="vcancel">Cancel</button><button class="primary" type="submit">Save village</button></div>
</form></dialog>

<dialog id="bk"><div class="dlg">
  <h2>Backup / restore</h2>
  <p>Episodes are saved in this browser only. Copy this text somewhere safe to back up. To restore, paste a backup and select Load backup.</p>
  <textarea id="bkt" rows="10" aria-label="Backup data"></textarea>
  <p id="bkmsg" class="sub" role="status"></p>
  <div class="dacts"><button id="bkclose">Close</button><button class="primary" id="bkload">Load backup</button></div>
</div></dialog>

<script>
(function(){
var KEY="shinobi-episodes-v1",eps=[],newest=true,editId=null;
var $=function(i){return document.getElementById(i)};
function load(){try{var r=localStorage.getItem(KEY);eps=r?JSON.parse(r):[];if(!Array.isArray(eps))eps=[]}catch(e){eps=[]}}
function persist(){try{localStorage.setItem(KEY,JSON.stringify(eps))}catch(e){}}
function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function split(s){return (s||"").split(",").map(function(x){return x.trim()}).filter(Boolean)}
function fmt(d){if(!d)return"";var p=d.split("-");if(p.length<3)return d;return new Date(p[0],p[1]-1,p[2]).toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"})}
function field(t,v,c){return v?'<div class="field '+(c||"")+'"><h3>'+t+'</h3><p>'+esc(v)+'</p></div>':""}
function render(){
  var q=$("q").value.trim().toLowerCase();
  var rows=eps.slice().sort(function(a,b){return newest?b.num-a.num:a.num-b.num});
  if(q)rows=rows.filter(function(e){return JSON.stringify(e).toLowerCase().indexOf(q)>-1});
  var chars={},jut={};eps.forEach(function(e){split(e.cast).forEach(function(c){chars[c.toLowerCase()]=1});split(e.jutsu).forEach(function(c){jut[c.toLowerCase()]=1})});
  $("stats").innerHTML='<span><b>'+eps.length+'</b>episodes</span><span><b>'+Object.keys(chars).length+'</b>characters</span><span><b>'+Object.keys(jut).length+'</b>techniques</span>';
  if(!rows.length){$("list").innerHTML='<div class="empty">'+(eps.length?"No episodes match your search.":"No episodes yet. Select Record new episode to log your first session.")+'</div>';return}
  $("list").innerHTML=rows.map(function(e){
    var meta=[e.arc?'<span class="arc">'+esc(e.arc)+'</span>':"",esc(e.rank),esc(fmt(e.date))].filter(Boolean).join(" | ");
    return '<article class="ep"><div class="epimg">'+epArt(e)+'</div><div class="body"><h2>'+esc(e.title)+'</h2><div class="meta">'+meta+'</div>'+epMissions(e.num)
    +(e.summary?'<p style="margin:0;white-space:pre-wrap">'+esc(e.summary)+'</p>':"")
    +(split(e.cast).length?'<div class="chips">'+split(e.cast).map(function(c){return'<span class="chip">'+esc(c)+'</span>'}).join("")+'</div>':"")
    +(split(e.jutsu).length?'<div class="chips">'+split(e.jutsu).map(function(c){return'<span class="chip j">'+esc(c)+'</span>'}).join("")+'</div>':"")
    +field("Battles",e.battles)+field("Rewards",e.rewards)+field("Next time",e.hook,"hook")
    +'<div class="acts"><button class="small primary" data-a="open" data-id="'+e.id+'">Open turns &amp; missions</button><button class="small" data-a="edit" data-id="'+e.id+'">Edit</button><button class="small" data-a="copy" data-id="'+e.id+'">Copy recap</button><button class="small danger" data-a="del" data-id="'+e.id+'">Delete</button></div></div></article>'}).join("");
}
var ids=["num","date","title","arc","rank","summary","cast","jutsu","battles","rewards","hook"];
function openForm(e){
  editId=e?e.id:null;$("dt").textContent=e?"Edit episode":"Record episode";
  ids.forEach(function(k){$(k).value=e&&e[k]!=null?e[k]:""});
  if(!e){var mx=eps.reduce(function(m,x){return Math.max(m,x.num)},0);$("num").value=mx+1;$("date").value=new Date().toISOString().slice(0,10)}
  epImg=e&&e.img?e.img:"";showEpPrev();$("epimsg").textContent="Choose an image, drag one onto this window, or copy an image and paste it here with Ctrl+V.";
  $("dlg").showModal();
}
$("new").onclick=function(){nextFlag=false;openForm(null)};
$("cancel").onclick=function(){$("dlg").close()};
$("f").onsubmit=function(ev){
  ev.preventDefault();
  var o={id:editId||String(Date.now())};
  ids.forEach(function(k){o[k]=$(k).value.trim()});o.num=parseInt(o.num,10)||1;o.img=epImg;
  if(editId){eps=eps.map(function(x){return x.id===editId?o:x})}else eps.push(o);
  persist();render();$("dlg").close();if(!editId){initEpisode(o);openEpisode(o.num)}
};
$("q").oninput=render;
$("order").onclick=function(){newest=!newest;this.textContent=newest?"Newest first":"Oldest first";render()};
$("list").onclick=function(ev){
  var b=ev.target.closest("button");if(!b)return;
  var e=eps.filter(function(x){return x.id===b.dataset.id})[0];if(!e)return;
  if(b.dataset.a==="open"){openEpisode(e.num);return}if(b.dataset.a==="edit")openForm(e);
  if(b.dataset.a==="del"){if(b.dataset.armed){eps=eps.filter(function(x){return x.id!==e.id});persist();render()}else{b.dataset.armed=1;b.textContent="Confirm delete";setTimeout(function(){b.dataset.armed="";b.textContent="Delete"},3000)}}
  if(b.dataset.a==="copy"){
    var t="Episode "+e.num+": "+e.title+(e.arc?" ("+e.arc+")":"")+"\n"+(e.summary||"")+(e.battles?"\nBattles: "+e.battles:"")+(e.rewards?"\nRewards: "+e.rewards:"")+(e.hook?"\nNext time: "+e.hook:"");
    var done=function(){b.textContent="Copied";setTimeout(function(){b.textContent="Copy recap"},1500)};
    try{navigator.clipboard.writeText(t).then(done,function(){window.prompt("Copy this recap:",t)})}catch(x){window.prompt("Copy this recap:",t)}
  }
};
$("backup").onclick=function(){$("bkt").value=JSON.stringify({episodes:eps,characters:chars,roster:roster,keywords:kws,villages:villages,map:mapS,missions:{list:missions,cur:curM},phases:phaseS,epdata:epData},null,1);$("bkmsg").textContent="";$("bk").showModal()};
$("bkclose").onclick=function(){$("bk").close()};
$("bkload").onclick=function(){
  try{var d=JSON.parse($("bkt").value);if(d&&!Array.isArray(d)){if(Array.isArray(d.characters)){chars=d.characters;cpersist()}if(Array.isArray(d.roster)){roster=d.roster;rpersist()}if(Array.isArray(d.keywords)){kws=d.keywords;kpersist()}if(Array.isArray(d.villages)){villages=d.villages;vpersist()}if(d.map&&Array.isArray(d.map.tokens)){mapS=Object.assign(mapS,d.map);saveMap()}if(d.missions&&Array.isArray(d.missions.list)&&d.missions.list.length)sv(MSK,d.missions);if(d.phases&&typeof d.phases==="object"&&!Array.isArray(d.phases)){phaseS=d.phases;sv(PK,phaseS)}if(d.epdata&&typeof d.epdata==="object"&&!Array.isArray(d.epdata)){epData=d.epdata;sv(EDK,epData)}loadMissions();renderVillages();renderChars();renderMap()}if(d&&!Array.isArray(d)&&d.episodes)d=d.episodes;if(!Array.isArray(d))throw 0;
    eps=d.filter(function(x){return x&&x.title}).map(function(x,i){x.id=x.id||String(Date.now()+i);x.num=parseInt(x.num,10)||i+1;return x});
    persist();render();$("bkmsg").textContent="Loaded "+eps.length+" episodes."}
  catch(e){$("bkmsg").textContent="That text isn’t a valid backup. Paste the full backup and try again."}
};
/* ---- villages, characters, all characters, keywords ---- */
var CK="shinobi-chars-v1",RK="shinobi-roster-v1",KK="shinobi-kw-v1",VK="shinobi-villages-v1",WK="shinobi-view-v1",MAPK="shinobi-map-v1",MSK="shinobi-missions-v1",PK="shinobi-phase-v1",DK="shinobi-dss-v1";
var chars=[],roster=[],kws=[],villages=[],tab="mission",vfilter="",rsel="",cTarget="mission",cEdit=null,vEdit=null,draft=[],draftImg="",lastRoll={},flashT={},missions=[],curM=0,phaseS={},dssT=6,curPhase="";
var RANKS={Genin:[50,100],Chunin:[60,120],Jonin:[70,140],Kage:[80,160]};
var JT={Offense:{cost:50,dice:5},Defense:{cost:50,dice:4},Supplementary:{cost:30,dice:0},Awakening:{cost:30,dice:0}};
var KT={Offense:35,Defense:30};
var KS={Offense:2,Defense:2,Supplementary:2,Awakening:1};
function ld(k){try{var r=localStorage.getItem(k),v=r?JSON.parse(r):[];return Array.isArray(v)?v:[]}catch(e){return[]}}
function sv(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
function cpersist(){sv(CK,chars)}function rpersist(){sv(RK,roster)}function kpersist(){sv(KK,kws)}function vpersist(){sv(VK,villages)}
function clamp(v,m){return Math.max(0,Math.min(m,v))}
var uidN=0;function uid(p){return p+Date.now().toString(36)+(uidN++).toString(36)+Math.floor(Math.random()*1296).toString(36)}
function clone(o){return JSON.parse(JSON.stringify(o))}
function byName(a,b){return a.name.localeCompare(b.name)}
function flash(id,t){$(id).textContent=t;clearTimeout(flashT[id]);flashT[id]=setTimeout(function(){$(id).textContent=""},3500)}
function costText(k){return JT[k].cost+" Chakra"+(JT[k].dice?", "+JT[k].dice+"d12":"")}
function catOf(s){s=(s||"").trim().toLowerCase();if(s.length<3)return null;for(var k in JT){if(k.toLowerCase().indexOf(s.slice(0,3))===0)return k}return null}
function newMove(){return{id:uid("m"),name:"",cat:"Offense",fx:"",kw:[]}}
function fxLines(fx){return(fx||"").split(/\r?\n/).map(function(l){return l.trim()}).filter(Boolean)}
function triggered(m,sum){return fxLines(m.fx).filter(function(l){var t=/^(\d+)\s*\+/.exec(l);return !t||sum>=parseInt(t[1],10)})}
function fxHtml(fx){return fxLines(fx).map(function(l){var i=l.indexOf(":");return i>0&&i<32?"<div><b>"+esc(l.slice(0,i))+":</b>"+esc(l.slice(i+1))+"</div>":"<div>"+esc(l)+"</div>"}).join("")}
function cleanMoves(){return draft.filter(function(m){return m.name.trim()}).map(function(m){return{id:m.id,name:m.name.trim(),cat:m.cat,fx:m.fx.trim(),kw:(m.kw||[]).slice(0,KS[m.cat]||1)}})}
function kwSlots(m){var k=m.kw||[],o=[];if(k[0])o.push({n:k[0],t:0});if((KS[m.cat]||1)>1&&k[1])o.push({n:k[1],t:KT[m.cat]||0});return o}
function ksm(cat){return KT[cat]?"unlocks at "+KT[cat]+"+":"always applies"}
function charOptions(list,first,prefix){
  var h=first?'<option value="">'+esc(first)+"</option>":"",g={};
  list.forEach(function(r){var n=vname(r.vid)||"No village";(g[n]=g[n]||[]).push(r)});
  Object.keys(g).sort().forEach(function(n){h+='<optgroup label="'+esc(n)+'">'+g[n].sort(byName).map(function(r){return'<option value="'+(prefix||"")+r.id+'">'+esc(r.name)+" ("+esc(r.rank)+")</option>"}).join("")+"</optgroup>"});
  return h;
}

/* villages */
