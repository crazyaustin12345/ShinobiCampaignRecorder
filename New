  ["camp","map","eps"].forEach(function(k){$("v-"+k).classList.toggle("hidden",k!==v)});
  Array.prototype.forEach.call(document.querySelectorAll("[data-view]"),function(b){b.setAttribute("aria-selected",b.dataset.view===v)});
  try{localStorage.setItem(WK,v)}catch(e){}
