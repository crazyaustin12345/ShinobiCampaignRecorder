  });
  out.push("Damage: "+O+(dm?" - "+D:"")+" = "+dmg+", plus "+AUTO+" automatic = "+total);
  var tr=triggered(mv,O);if(tr.length)out.push("Effects: "+tr.join(" | "));
  var ks=kwSlots(mv),on=ks.filter(function(q){return !q.t||O>=q.t});
