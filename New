    logTo(m,a.name+" uses "+mv.name+" on "+t.name+": offense "+O+(dm?", "+t.name+" defends with "+dm.name+" ("+D+")":", no defense")+". "+dmg+" damage plus "+AUTO+" automatic.","jutsu",mv.name,{who:a.name,ck:costA});
