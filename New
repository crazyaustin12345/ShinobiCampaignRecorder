function updateDuelCalc(){
  var P=duelParts();if(!P||duel.stage!=="arena"||!P.t)return;
  var no=JT[P.mv.cat].dice,nd=JT.Defense.dice,okO=okTot(duel.ot,no),okD=P.dm?okTot(duel.dt,nd):true;
  var O=okO?duel.ot:0,D=P.dm&&okD?duel.dt:0,dmg=Math.max(0,O-D),total=dmg+AUTO,ready=okO&&okD;
  var h=ready?"<b>"+O+"</b> offense"+(P.dm?" &minus; <b>"+D+"</b> defense":"")+" = <b>"+dmg+"</b> + <b>"+AUTO+" automatic</b> = <b>"+total+" damage</b>"+(P.dm&&O<=D?" (the defense holds, only the automatic damage lands)":""):"Enter the total"+(P.dm?"s":"")+" from your physical dice to see the damage.";
  if(duel.ot!==undefined&&!okO)h+="<p>The offense total must be a whole number from "+no+" to "+12*no+".</p>";
