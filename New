      if(dtr.length)h+="<p>Defense effects: "+esc(dtr.join(" | "))+"</p>";
      if(don.length)h+="<p>Defense keywords: "+esc(don.map(function(q){return q.n}).join(", "))+"</p>";
      if(doff.length)h+="<p>Defense locked: "+esc(doff.map(function(q){return q.n+" (needs "+q.t+"+)"}).join(", "))+"</p>";
    }
