/* card actions */
function cardAction(ev,isM){
  var b=ev.target.closest("button");if(!b)return;
  var a=b.dataset.a,list=isM?chars:roster,c=list.filter(function(x){return x.id===b.dataset.id})[0];if(!c)return;
  var fm=isM?"emsg":"cmsg",m=isM?mOf(c):null;
