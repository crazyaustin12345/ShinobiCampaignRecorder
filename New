}
Array.prototype.forEach.call(document.querySelectorAll("[data-view]"),function(b){b.onclick=function(){setView(b.dataset.view)}});

chars=ld(CK);roster=ld(RK);kws=ld(KK);loadMap();loadPhase();loadEpData();loadStat();loadMissions();ensureKwIds();seedVillages();buildMap();renderVillages();renderChars();
