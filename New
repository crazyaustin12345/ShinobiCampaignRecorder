  }
  else if(a==="ko"||a==="uko"){
    if(c.hp<=0)return;
    var drop=applyDamage(c,m,10,a==="uko"?"Ultimate Jutsu KO":"KO");
    if(a==="uko"){ultNote={id:c.id,name:c.name};if(m)logTo(m,"Reminder for "+c.name+": subtract the difference between the offense and defense die results for extra damage.","sys")}
    cpersist();renderChars();
    flash(fm,drop?c.name+" is in Death Saving Mode!":c.name+" takes 10 damage"+(a==="uko"?" from an Ultimate Jutsu KO. Remember to subtract the difference between the offense and defense die results for extra damage.":"."));
  }
  else if(a==="rest"){c.hp=c.maxHp;c.ck=c.maxCk;c.st=[];if(m)logTo(m,c.name+" is fully restored and cleared of status conditions.","hp");cpersist();renderChars()}
  else if(a==="edit")openC(c,isM?"mission":"roster");
  else if(a==="rem"||a==="rdel"){
    if(b.dataset.armed){if(a==="rem"){if(m)logTo(m,c.name+" leaves the mission.","sys");chars=chars.filter(function(x){return x.id!==c.id});cpersist()}else{roster=roster.filter(function(x){return x.id!==c.id});rpersist()}renderChars();renderMap()}
    else{b.dataset.armed=1;b.textContent="Confirm";setTimeout(function(){b.dataset.armed="";if(b.isConnected)b.textContent=a==="rem"?"Remove from mission":"Delete"},3000)}
  }
  else if(a==="dsroll"||a==="dsok"||a==="dsfail"){
    syncDss(c);var d=c.ds,okk,st0=dssState(c);
    if(a==="dsroll"){var rr=1+Math.floor(Math.random()*10);okk=rr>=dssT;c.dsLast="Rolled D10: "+rr+(okk?" - success":" - failure")}
    else{okk=a==="dsok";c.dsLast=""}
    if(okk)d.ok=Math.min(3,(d.ok||0)+1);else d.fail=Math.min(3,(d.fail||0)+1);
    if(m){
      logTo(m,c.name+" death save: "+(c.dsLast||(okk?"success":"failure"))+" ("+d.ok+" successes, "+d.fail+" failures).","hp");
      var st1=dssState(c);
      if(st1!==st0&&st1==="dead")logTo(m,c.name+" has died.","hp","",{who:c.name,dead:true});
      else if(st1!==st0&&st1==="stable")logTo(m,c.name+" is stabilized.","hp");
    }
    cpersist();renderChars();
  }
  else if(a==="use"){
    var mv=(c.moves||[]).filter(function(x){return x.id===b.dataset.j})[0];if(!mv)return;
    var t=JT[mv.cat];if(c.ck<t.cost||c.hp<=0)return;
    if(isM&&mv.cat==="Offense"&&m){openDuel(c,mv);return}
    c.ck-=t.cost;var out=[mv.name+": spent "+t.cost+" Chakra"],sum=Infinity;
    if(t.dice){var rl=[],tot=0,n,v;for(n=0;n<t.dice;n++){v=1+Math.floor(Math.random()*12);rl.push(v);tot+=v}sum=tot;out[0]+=". Rolled "+t.dice+"d12 ["+rl.join(", ")+"] = "+tot}
    var tr=triggered(mv,sum);if(tr.length)out.push("Effects: "+tr.join(" | "));
    var ks=kwSlots(mv),on2=ks.filter(function(q){return !q.t||sum>=q.t}),off=ks.filter(function(q){return q.t&&sum<q.t});
    if(on2.length)out.push("Keywords: "+on2.map(function(q){return q.n}).join(", "));
    if(off.length)out.push("Locked: "+off.map(function(q){return q.n+" (needs "+q.t+"+)"}).join(", "));
    lastRoll[c.id]=out;
    if(m)logTo(m,c.name+" uses "+out.join(" | "),"jutsu",mv.name,{who:c.name,ck:t.cost});
    cpersist();renderChars();
  }
}
function cardChange(ev){
  var t=ev.target;if(!t.classList.contains("cur"))return;
  var c=chars.filter(function(x){return x.id===t.dataset.id})[0];if(!c)return;var k=t.dataset.k;
  if(epd().ended){flash("emsg","This episode is complete, so its characters are locked.");renderChars();return}
  var was=c[k],m=mOf(c);c[k]=clamp(parseInt(t.value,10)||0,c[k==="hp"?"maxHp":"maxCk"]);
  if(m&&c[k]!==was){
